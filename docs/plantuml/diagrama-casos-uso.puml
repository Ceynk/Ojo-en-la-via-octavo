  usecase "Verificar reportes duplicados" as UC10
  usecase "Visualizar Mapa" as UC11
  usecase "Buscar ubicacion" as UC12
  usecase "Visualizar Reporte" as UC13
  usecase "Comentar reporte" as UC14
